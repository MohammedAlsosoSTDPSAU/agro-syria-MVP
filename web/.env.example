# ── Supabase (P0 auth + persistence) ────────────────────────────────────
# Leave unset to run in offline/demo mode (localStorage only).
# Set both to enable phone-OTP auth + DB-backed fields.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Existing optional integrations ───────────────────────────────────────
# FastAPI backend proxy target (chat/market). Unset → local fallback engine.
FASTAPI_URL=
# Not currently read by any code path (chat's LLM call lives entirely behind
# FASTAPI_URL; the dashboard briefing also goes through that same chat
# pipeline, not a separate Gemini call). Reserved for a future direct-Gemini
# integration if one is added.
GOOGLE_GEMINI_API_KEY=
