# ── Supabase (P0 auth + persistence) ────────────────────────────────────
# Leave unset to run in offline/demo mode (localStorage only).
# Set both to enable phone-OTP auth + DB-backed fields.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Existing optional integrations ───────────────────────────────────────
# FastAPI backend proxy target (chat/market). Unset → local fallback engine.
FASTAPI_URL=
# Server-side AI (dashboard briefing / chat). Unset → static briefing.
GOOGLE_GEMINI_API_KEY=
