# ── Google Gemini (free tier) via OpenAI-compatible endpoint ─────────────
# Setting GEMINI_API_KEY auto-selects the Gemini provider (no PROVIDER var).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Optional ─────────────────────────────────────────────────────────────
# APP_ENV=production
# Allow the Vercel frontend origin if anything calls this API from the browser.
# (Not required when the Next.js route proxies server-to-server.)
# CORS_ORIGINS=https://agro-syria.vercel.app,http://localhost:3000
