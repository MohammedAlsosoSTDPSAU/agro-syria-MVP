# ── Groq (primary) via its OpenAI-compatible endpoint ─────────────────────
# Setting GROQ_API_KEY auto-selects Groq (highest priority provider).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Google Gemini (secondary — used only if GROQ_API_KEY is unset) ───────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Optional ─────────────────────────────────────────────────────────────
# APP_ENV=production
# Allow the Vercel frontend origin if anything calls this API from the browser.
# (Not required when the Next.js route proxies server-to-server.)
# CORS_ORIGINS=https://agro-syria.vercel.app,http://localhost:3000
